FOR EACH ROW
BEGIN
    UPDATE STOCK SET cerrados = cerrados + NEW.cantidad WHERE id_producto = NEW.id_producto;
END //

-- Este trigger se asegura de que si se registra una salida general, se reste por defecto de cerrados
CREATE TRIGGER actualizar_stock_salida AFTER INSERT ON SALIDAS
FOR EACH ROW
BEGIN
    UPDATE STOCK SET cerrados = cerrados - NEW.cantidad WHERE id_producto = NEW.id_producto;
END //

DELIMITER ;


