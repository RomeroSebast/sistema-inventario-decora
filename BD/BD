-- 1. Crear la base de datos con el nombre original
CREATE DATABASE IF NOT EXISTS sistema_inventario;
USE sistema_inventario;

-- 2. Tabla de Proveedores (Necesaria para registrar productos)
CREATE TABLE PROVEEDORES (
    id_proveedor INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    contacto VARCHAR(100)
);

-- 3. Tabla de Usuarios (Para manejar roles de Admin y UsuarioComun)
CREATE TABLE USUARIOS (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    usuario VARCHAR(50) UNIQUE NOT NULL,
    contraseña VARCHAR(255) NOT NULL,
    tipo_usuario ENUM('Admin', 'UsuarioComun') NOT NULL
);

-- 4. Tabla de Productos (Relacionada con Proveedores)
CREATE TABLE PRODUCTOS (
    id_producto INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    id_proveedor INT,
    FOREIGN KEY (id_proveedor) REFERENCES PROVEEDORES(id_proveedor)
);

-- 5. Tabla de Stock (Actualizada automáticamente por Triggers)
CREATE TABLE STOCK (
    id_stock INT AUTO_INCREMENT PRIMARY KEY,
    id_producto INT,
    cantidad INT DEFAULT 0,
    FOREIGN KEY (id_producto) REFERENCES PRODUCTOS(id_producto) ON DELETE CASCADE
);

-- 6. Tablas de Movimientos (Para el historial)
CREATE TABLE ENTRADAS (
    id_entrada INT AUTO_INCREMENT PRIMARY KEY,
    id_producto INT,
    cantidad INT,
    id_usuario INT,
    fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_producto) REFERENCES PRODUCTOS(id_producto),
    FOREIGN KEY (id_usuario) REFERENCES USUARIOS(id_usuario)
);

CREATE TABLE SALIDAS (
    id_salida INT AUTO_INCREMENT PRIMARY KEY,
    id_producto INT,
    cantidad INT,
    proyecto VARCHAR(100),
    id_usuario INT,
    fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_producto) REFERENCES PRODUCTOS(id_producto),
    FOREIGN KEY (id_usuario) REFERENCES USUARIOS(id_usuario)
);

