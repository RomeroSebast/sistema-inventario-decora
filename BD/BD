-- Trigger para sumar stock al registrar entrada
CREATE TRIGGER actualizar_stock_entrada AFTER INSERT ON ENTRADAS
FOR EACH ROW
BEGIN
    UPDATE STOCK SET cantidad = cantidad + NEW.cantidad WHERE id_producto = NEW.id_producto;
END //

-- Trigger para restar stock al registrar salida
CREATE TRIGGER actualizar_stock_salida AFTER INSERT ON SALIDAS
FOR EACH ROW
BEGIN
    UPDATE STOCK SET cantidad = cantidad - NEW.cantidad WHERE id_producto = NEW.id_producto;
END //

DELIMITER ;

